# Desenvolvimento local com os emuladores do Firebase (npm run dev:emulators).
# Projetos "demo-*" não precisam de credenciais reais.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ponto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ponto
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-ponto
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
INSTALL_SECRET=segredo-local
