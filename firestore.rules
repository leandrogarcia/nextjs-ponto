rules_version = '2';

// Toda escrita passa pelos Route Handlers com o Admin SDK, que ignora estas
// regras. O cliente só pode ler o que o perfil permite (custom claim `role`).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }
    function isManager() {
      return hasRole('gerencia');
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isManager() || hasRole('root');
      allow write: if false;
    }

    match /workSchedules/{uid} {
      allow read: if isSelf(uid) || isManager();
      allow write: if false;
    }

    match /timeEntries/{entryId} {
      allow read: if isManager() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isManager() || hasRole('root');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
