# Configuração web do Firebase (Console > Configurações do projeto > Seus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Conta de serviço do Admin SDK (Console > Contas de serviço > Gerar nova chave privada)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave em uma linha, com \n no lugar das quebras de linha
FIREBASE_PRIVATE_KEY=

# Segredo exigido pela rota /install
INSTALL_SECRET=

# Opcional: intervalo mínimo entre marcações, em segundos (padrão 60)
# PUNCH_MIN_INTERVAL_SECONDS=60
